{
  "name": "anylist",
  "description": "📋 a wrapper for AnyList's API (unoffical, reverse engineered)",
  "keywords": [
    "📋",
    "anylist",
    "grocery",
    "list",
    "api",
    "wrapper",
    "client",
    "recipe"
  ],
  "version": "0.8.6",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "Max Isom <hi@maxisom.me> (https://maxisom.me/)",
  "scripts": {
    "test": "mocha 'test/**/*.test.js'",
    "lint": "xo",
    "lint-fix": "xo --fix",
    "document": "documentation build lib/index.js -f html -o docs",
    "test:unit": "mocha 'test/**/*.unit.test.js'"
  },
  "dependencies": {
    "form-data": "^3.0.5",
    "got": "^11.8.6",
    "protobufjs": "5.0.3",
    "reconnecting-websocket": "^4.2.0",
    "tough-cookie": "^4.1.3",
    "ws": "^7.5.12"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "documentation": "^12.1.4",
    "husky": "^4.3.8",
    "mocha": "^11.7.5",
    "xo": "^0.56.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint && yarn run document"
    }
  },
  "xo": {
    "ignores": [
      "docs",
      "test"
    ],
    "rules": {
      "unicorn/prefer-module": "off",
      "unicorn/prefer-string-replace-all": "off",
      "unicorn/prefer-node-protocol": "off",
      "import/extensions": "off",
      "unicorn/prefer-event-target": "off"
    }
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetheweb/anylist.git"
  },
  "bugs": {
    "url": "https://github.com/codetheweb/anylist/issues"
  },
  "homepage": "https://github.com/codetheweb/anylist",
  "engines": {
    "node": ">=16.0.0"
  },
  "allowScripts": {
    "highlight.js": false,
    "husky": false
  }
}
